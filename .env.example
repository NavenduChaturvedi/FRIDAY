# Copy to .env and fill in. Everything here has a sane default except the
# Gemini key — without it FRIDAY just runs on local Ollama.

# ── Brain: Gemini (primary) ─────────────────────────────────────────────
GEMINI_API_KEY=
# FRIDAY_GEMINI_MODEL=gemini-flash-latest   # or pin e.g. gemini-2.5-flash
# FRIDAY_GEMINI_TIMEOUT=20

# ── Brain: Ollama (fallback) ────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# Comma-separated, tried in order; first to answer wins.
# FRIDAY_OLLAMA_MODELS=qwen2.5:3b,qwen3.5:4b,gemma4:latest
# FRIDAY_OLLAMA_TIMEOUT=60

# ── Brain: generation ───────────────────────────────────────────────────
# FRIDAY_MAX_REPLY_TOKENS=400
# FRIDAY_TEMPERATURE=0.7
# FRIDAY_HISTORY_TURNS=8

# ── Persona ─────────────────────────────────────────────────────────────
# FRIDAY_PERSONA=friday

# ── Tools (tools/*.py) ──────────────────────────────────────────────────
# FRIDAY_TOOLS_DIR=tools
# Comma-separated allowlist; empty = every tool in the dir is enabled.
# FRIDAY_TOOLS_ENABLED=get_time,set_timer,web_search
# FRIDAY_MAX_TOOL_ITERATIONS=4

# ── Speech-to-text (faster-whisper) ─────────────────────────────────────
# FRIDAY_WHISPER_MODEL=tiny          # tiny | base | small | medium | large-v3
# FRIDAY_WHISPER_DEVICE=cpu          # cpu | cuda
# FRIDAY_WHISPER_COMPUTE=int8        # int8 | int8_float16 | float16 | float32

# ── Text-to-speech (Piper) ──────────────────────────────────────────────
# Bare filename resolves against the repo root; needs a matching .onnx.json.
# FRIDAY_PIPER_VOICE=en_GB-jenny_dioco-medium.onnx

# ── Microphone / capture ────────────────────────────────────────────────
# FRIDAY_SILENCE_THRESHOLD=0.03      # raise if it triggers on room noise
# FRIDAY_MAX_RECORDING_SECONDS=30
