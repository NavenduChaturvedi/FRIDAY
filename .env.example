# Copy to .env and fill in. Everything here has a sane default.

# ── Brain: provider order ──────────────────────────────────────────────
# Tried left to right; first to answer wins. Ollama leads for now — once
# you have a paid Gemini key, set this to: gemini,ollama
# FRIDAY_BRAIN_ORDER=ollama,gemini

# ── Brain: Ollama (per request type — see friday/router.py) ────────────
# On a memory-tight laptop also set OLLAMA_MAX_LOADED_MODELS=1 in Ollama's
# own environment — FRIDAY unloads its own models when switching, but that
# env var stops anything from stacking three at once.
# OLLAMA_HOST=http://localhost:11434
# One model for every route by default — zero reloads, ~5 GB resident.
# FRIDAY_OLLAMA_MODEL_CHAT=llama3.1:8b
# FRIDAY_OLLAMA_MODEL_COMPLEX=llama3.1:8b        # gemma4:latest if you have the RAM
# FRIDAY_OLLAMA_MODEL_CODE=llama3.1:8b           # qwen2.5-coder:7b for real code work
# Fallback list if a routed model isn't pulled or errors:
# FRIDAY_OLLAMA_MODELS=llama3.1:8b,qwen2.5:7b,gemma4:latest
# FRIDAY_OLLAMA_TIMEOUT=150
# How long Ollama keeps a model warm after use.
# FRIDAY_OLLAMA_KEEP_ALIVE=10m
# Seconds of quiet after which FRIDAY unloads the routed model to free its
# ~5 GB while you're not talking to her (next turn pays a cold load). 0 = off.
# FRIDAY_OLLAMA_IDLE_UNLOAD=180

# ── Brain: Gemini (no key = skipped) ──────────────────────────────────
GEMINI_API_KEY=
# FRIDAY_GEMINI_MODEL=gemini-flash-latest        # handles CHAT
# FRIDAY_GEMINI_MODEL_HEAVY=gemini-pro-latest    # COMPLEX + CODE (blank = same as above)
# FRIDAY_GEMINI_TIMEOUT=20

# ── Brain: generation ───────────────────────────────────────────────────
# FRIDAY_MAX_REPLY_TOKENS=400
# FRIDAY_TEMPERATURE=0.7
# FRIDAY_HISTORY_TURNS=8
# How much of persistent memory (state/memory.json) rides in the prompt:
# FRIDAY_MEMORY_CORE_CHARS=1000

# ── Persona ─────────────────────────────────────────────────────────────
# FRIDAY_PERSONA=friday

# ── Wake word ───────────────────────────────────────────────────────────
# The word that gets her attention. "off" = respond to everything.
# FRIDAY_WAKE_WORD=friday
# FRIDAY_WAKE_SENSITIVITY=0.5
# For a real always-on detector: `pip install pvporcupine`, get a free key at
# console.picovoice.ai, and set it here + FRIDAY_WAKE_WORD to a Porcupine
# keyword (jarvis, computer, …). Without a key she transcribes everything but
# only acts on turns that name her.
# PICOVOICE_ACCESS_KEY=

# ── Tools (tools/*.py) ──────────────────────────────────────────────────
# FRIDAY_TOOLS_DIR=tools
# Comma-separated allowlist; empty = every tool in tools/ is enabled.
# FRIDAY_TOOLS_ENABLED=get_time,set_timer,web_search,calculate,get_weather
# Tools per request type (small models choke on all 18 at once). CODE gets
# none. Use "all" once a capable cloud model leads the chain.
# FRIDAY_CHAT_TOOLS=get_time,get_weather,set_timer,reminder,schedule,notes,memory,web_search,calculate,system_status,launch_app
# FRIDAY_COMPLEX_TOOLS=get_time,get_weather,web_search,wikipedia_lookup
# FRIDAY_MAX_TOOL_ITERATIONS=4
# Ask out loud before a destructive tool call (notes clear, memory forget);
# only a clear "yes" next turn runs it. "undo" / "undo that" reverses the last
# change either way. false = destructive calls fire straight away.
# FRIDAY_CONFIRM_ACTIONS=true
# Where notes/reminders are stored:
# FRIDAY_STATE_DIR=state

# ── Scheduler / morning briefing (tools/schedule.py) ───────────────────
# "Friday, give me a morning briefing every weekday at 7" -> a recurring job
# that speaks the time, weather, today's reminders and your notes on your next
# turn after it's due. City for the weather line (blank = no weather):
# FRIDAY_HOME_CITY=
# FRIDAY_BRIEFING_NEWS=false          # add a couple of headlines (extra call)
# FRIDAY_SCHEDULE_GRACE_MINUTES=120   # a late non-briefing job past this is skipped

# ── Speech-to-text (faster-whisper) ─────────────────────────────────────
# CPU or NVIDIA-CUDA only (no AMD NPU/GPU). CPU times for a 6s clip:
# tiny ~0.7s, base ~1.3s, small ~3.8s.
# FRIDAY_WHISPER_MODEL=base          # tiny | base | small | medium | large-v3
# FRIDAY_WHISPER_DEVICE=cpu          # cpu | cuda
# FRIDAY_WHISPER_COMPUTE=int8        # int8 | int8_float16 | float16 | float32
# FRIDAY_WHISPER_CPU_THREADS=0       # 0 = auto; raise toward core count for big models

# ── Text-to-speech (Piper) ──────────────────────────────────────────────
# Bare filename resolves against the repo root; needs a matching .onnx.json.
# FRIDAY_PIPER_VOICE=en_GB-jenny_dioco-medium.onnx

# ── Microphone / capture ────────────────────────────────────────────────
# FRIDAY_SILENCE_THRESHOLD=0.03      # raise if it triggers on room noise
# FRIDAY_MAX_RECORDING_SECONDS=30
